{% extends 'index.twig' %}

{% block content %}
<section class="col-12 pmf-form-page">
  <header class="pmf-page-header">
    <h1 class="h2 pmf-display-2 mb-0">{{ 'msgUserRemoval' | translate }}</h1>
    <p class="pmf-page-lead">{{ 'msgUserRemovalText' | translate }}</p>
  </header>

  <div class="pmf-callout mb-4">
    <p class="mb-1">
      {{ 'msgContactPrivacyNote' | translate }}
      <a title="{{ 'msgPrivacyNote' | translate }}" href="{{ privacyURL }}" target="_blank" rel="noopener">
        {{ 'msgPrivacyNote' | translate }}
      </a>
    </p>
    <p class="mb-0"><strong>{{ 'msgContactRemove' | translate }}</strong></p>
  </div>

  <div class="row mb-2">
    <div class="col">
      <div class="spinner-border text-primary d-none" id="loader" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
      <div id="pmf-request-removal-response"></div>
    </div>
  </div>

  <form id="pmf-request-removal-form" action="#" method="post" class="needs-validation pmf-surface pmf-form-card" novalidate>
    <input type="hidden" name="lang" id="lang" value="{{ lang }}">
    <input type="hidden" name="userId" id="userId" value="{{ userId }}">
    {{ csrf | raw }}

    <div class="row mb-2">
      <label class="col-sm-3 col-form-label" for="loginname">{{ 'msgUsername' | translate }}</label>
      <div class="col-sm-9">
        <input
          type="text"
          class="form-control-plaintext"
          name="loginname"
          id="loginname"
          value="{{ defaultLoginName }}"
          readonly
          required
        />
      </div>
    </div>

    <div class="row mb-2">
      <label class="col-sm-3 col-form-label" for="name">{{ 'msgNewContentName' | translate }}</label>
      <div class="col-sm-9">
        <input
          type="text"
          class="form-control-plaintext"
          name="name"
          id="name"
          value="{{ defaultContentName }}"
          readonly
          required
        />
      </div>
    </div>

    <div class="row mb-2">
      <label class="col-sm-3 col-form-label" for="email">{{ 'msgNewContentMail' | translate }}</label>
      <div class="col-sm-9">
        <input
          type="email"
          class="form-control-plaintext"
          name="email"
          id="email"
          value="{{ defaultContentMail }}"
          readonly
          required
        />
      </div>
    </div>

    <div class="row mb-2">
      <label class="col-sm-3 col-form-label" for="question">{{ 'msgMessage' | translate }}</label>
      <div class="col-9">
        <textarea class="form-control" cols="37" rows="5" name="question" id="question" required></textarea>
      </div>
    </div>

    <div class="row pmf-form-actions">
      <div class="col-sm-12 text-end">
        <button
          class="btn btn-primary btn-lg"
          type="submit"
          id="pmf-submit-request-removal"
          data-pmf-form="submit-request-removal"
        >
          {{ 'msgNewContentSubmit' | translate }}
        </button>
      </div>
    </div>
  </form>
</section>

{% endblock %}
