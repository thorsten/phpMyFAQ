<!DOCTYPE html>
<html lang="{{ metaLanguage }}" data-bs-theme="{{ forcedLayoutMode ?? (defaultLayoutMode == 'auto' ? 'light' : defaultLayoutMode) }}"
      data-pmf-default-theme="{{ defaultLayoutMode|default('auto') }}"
      data-pmf-allow-user-theme="{{ allowUserLayoutMode is defined and allowUserLayoutMode ? 'true' : 'false' }}"
      {%- if forcedLayoutMode is defined and forcedLayoutMode is not null %} data-pmf-forced-theme="{{ forcedLayoutMode }}"{% endif %}>
<head>
  <meta charset="utf-8">

  {% if forcedLayoutMode is not defined or forcedLayoutMode is null %}
  <script nonce="{{ cspNonce() }}">
    (function () {
      try {
        var root = document.documentElement;
        var defaultMode = root.getAttribute('data-pmf-default-theme') || 'auto';
        var stored = root.getAttribute('data-pmf-allow-user-theme') !== 'false'
          ? localStorage.getItem('pmf-theme')
          : null;
        var theme = stored
          ? stored
          : (defaultMode === 'auto'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : defaultMode);
        root.setAttribute('data-bs-theme', theme);
      } catch (e) {
        // localStorage may be unavailable (e.g. blocked storage); keep the server-rendered theme
      }
    })();
  </script>
  {% endif %}

  <script nonce="{{ cspNonce() }}">
    (function () {
      try {
        var size = localStorage.getItem('pmf-font-size');
        if (['80', '90', '110', '120'].indexOf(size) !== -1) {
          document.documentElement.setAttribute('data-pmf-font-size', size);
        }
      } catch (e) {
        // localStorage may be unavailable (e.g. blocked storage); keep the default font size
      }
    })();
  </script>

  <title>{{ title }}</title>
  <base href="{{ baseHref }}">

  <meta content="{{ metaDescription }}" name="description">
  <meta content="{{ metaPublisher }}" name="author">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <meta content="phpMyFAQ {{ phpmyfaqVersion }}" name="application-name">
  <meta content="{{ metaRobots }}" name="robots">
  <meta content="7 days" name="revisit-after">

  {% if isDebugEnabled %}<link href="{{ baseHref }}{{ asset('assets/public/debugMode.css') }}" rel="stylesheet">{% endif %}

  <link href="{{ baseHref }}{{ asset('assets/public/styles.css') }}" rel="stylesheet" media="screen">
  <link href="{{ baseHref }}{{ asset('assets/templates/' ~ tplSetName ~ '/theme.css') }}" rel="stylesheet" media="screen">
  {% if customCss is not empty %}
  <style media="screen">
    {{ customCss | raw }}
  </style>
  {% endif %}
  {% if pluginStylesheets is defined and pluginStylesheets is not empty %}
    {% for stylesheet in pluginStylesheets %}
  <link href="{{ baseHref }}{{ stylesheet }}" rel="stylesheet" media="screen">
    {% endfor %}
  {% endif %}
  <link href="{{ baseHref }}assets/images/favicon.ico" rel="shortcut icon">
  <link href="{{ currentPageUrl }}" rel="canonical">

  {% if richSnippetsEnabled %}
  {% block richSnippets %}{% endblock %}
  {% endif %}

</head>
<body class="pmf-page-wrapper pmf-template-{{ tplSetName }}" dir="{{ dir }}">

<nav class="navbar navbar-expand-lg navbar-dark p-1 text-bg-pmf-nav border-bottom sticky-top">
  <div class="container">
    <a class="navbar-brand" href="{{ faqHome }}" id="phpmyfaq-logo" title="{{ header }}">
      <img width="130" height="40" src="{{ baseHref }}assets/images/logo-transparent.svg" alt="{{ title }}"
           title="{{ title }}">
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#pmf-top-navbar"
            aria-controls="pmf-top-navbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="pmf-top-navbar">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        {% if not isMaintenanceMode %}
          {# A highlighted item is the one accent button and moves to the right-hand side. #}
          {% for item in topNavigation %}
            {% if not (item['highlight'] ?? false) %}
            <li class="nav-item pmf-nav-link ">
              <a class="pmf-nav-link {{ item['active'] }}" href="{{ item['link'] }}">{{ item['name'] }}</a>
            </li>
            {% endif %}
          {% endfor %}
        {% endif %}
      </ul>

      <ul class="navbar-nav flex-row flex-wrap align-items-center ms-md-auto">
        <li class="nav-item dropdown me-2">
          <button type="button" class="btn btn-link nav-link pmf-nav-pill-ghost pmf-nav-icon-button"
                  data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" aria-expanded="false"
                  aria-label="{{ 'msgDisplaySettings' | translate }}" title="{{ 'msgDisplaySettings' | translate }}">
            <i class="bi bi-circle-half" aria-hidden="true"></i>
          </button>
          <div class="dropdown-menu dropdown-menu-end pmf-display-menu">
            {% if allowUserLayoutMode %}
            <div class="pmf-display-menu-row">
              <span class="pmf-display-menu-label" id="pmf-display-menu-theme">{{ 'msgToggleTheme' | translate }}</span>
              <div class="btn-group pmf-theme-switcher" role="group" aria-labelledby="pmf-display-menu-theme">
                <button type="button" class="btn btn-link nav-link py-2 px-2" id="theme-light"
                        aria-label="Light mode" title="Light mode">
                  <i class="bi bi-sun-fill"></i>
                </button>
                <button type="button" class="btn btn-link nav-link py-2 px-2" id="theme-dark"
                        aria-label="Dark mode" title="Dark mode">
                  <i class="bi bi-moon-stars-fill"></i>
                </button>
                <button type="button" class="btn btn-link nav-link py-2 px-2" id="theme-high-contrast"
                        aria-label="High contrast mode" title="High contrast mode">
                  <i class="bi bi-circle-half"></i>
                </button>
              </div>
            </div>
            {% endif %}
            <div class="pmf-display-menu-row">
              <span class="pmf-display-menu-label" id="pmf-display-menu-font-size">{{ 'msgFontSize' | translate }}</span>
              <div class="btn-group pmf-theme-switcher pmf-font-size-switcher" role="group"
                   aria-labelledby="pmf-display-menu-font-size">
                <button type="button" class="btn btn-link nav-link py-2 px-2" id="font-size-decrease"
                        aria-label="{{ 'msgFontSizeDecrease' | translate }}" title="{{ 'msgFontSizeDecrease' | translate }}">
                  <i class="bi bi-dash-lg"></i>
                </button>
                <button type="button" class="btn btn-link nav-link py-2 px-2" id="font-size-increase"
                        aria-label="{{ 'msgFontSizeIncrease' | translate }}" title="{{ 'msgFontSizeIncrease' | translate }}">
                  <i class="bi bi-plus-lg"></i>
                </button>
              </div>
            </div>
          </div>
        </li>
        {% if not isMaintenanceMode %}
          {% for item in topNavigation %}
            {% if item['highlight'] ?? false %}
            <li class="nav-item me-2">
              <a class="pmf-nav-cta" href="{{ item['link'] }}"{% if item['active'] %} aria-current="page"{% endif %}>{{ item['name'] }}</a>
            </li>
            {% endif %}
          {% endfor %}
        {% endif %}
        <li class="nav-item dropdown">
          <button type="button" class="btn btn-link nav-link py-2 px-0 px-lg-2 dropdown-toggle pmf-nav-pill-ghost"
                  data-bs-toggle="dropdown" aria-expanded="false" data-bs-display="static">
            {{ msgLoginUser }}
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            {% if not isUserLoggedIn %}
              {% if isUserRegistrationEnabled %}
                <li><a class="dropdown-item" href="./user/register">{{ 'msgRegisterUser' | translate }}</a></li>
              {% endif %}
              <li><a class="dropdown-item" href="./login">{{ msgLoginUser }}</a></li>
            {% else %}
              <li><a class="dropdown-item" href="./user/ucp">{{ msgUserControlDropDown }}</a></li>
              <li><a class="dropdown-item" href="./user/bookmarks">{{ msgBookmarks }}</a></li>
              <li>
                <a class="dropdown-item d-flex align-items-center" href="./user/chat">
                  {{ 'msgChat' | translate }}
                  {% if unreadChatCount is defined and unreadChatCount > 0 %}
                    <span class="badge bg-danger ms-auto">{{ unreadChatCount }}</span>
                  {% endif %}
                </a>
              </li>
              <li><a class="dropdown-item" href="./user/request-removal">{{ msgUserRemoval }}</a></li>
              <li><hr class="dropdown-divider"></li>
              {% if isUserHasAdminRights %}
                <li><a class="dropdown-item" href="./admin">{{ msgAdmin }}</a></li>
              {% endif %}
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="./logout?csrf={{ csrfLogout }}">{{ msgLogoutUser }}</a></li>
            {% endif %}
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>

<!-- SEARCH -->
{% set isSearchPage = (currentPageUrl matches '/\\/search\\.html([?#]|$)/') or (currentPageUrl matches '/[?&]action=search(&|$)/') %}
{# startpage.twig sets isStartPage and renders the search form inside its hero instead. #}
{% if not isMaintenanceMode and not isSearchPage and not (isStartPage ?? false) %}
<div class="pmf-search-band">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        {% include 'partials/search-form.twig' %}
      </div>
    </div>
  </div>
</div>
{% endif %}

<!-- MAIN CONTENT -->
<section class="my-3{%  if isSearchPage %} mt-5{% endif %}" id="wrapper">
  <div class="container">
  {% if not isMaintenanceMode %}
    {% block content %}{% endblock %}
  {% else %}
    We're currently in maintenance mode. Please come back later.
  {% endif %}
  </div>
</section>

<footer class="footer pmf-footer pt-5 pb-4">
  <div class="container">
    <div class="row pb-2">
      <div class="col-lg-4 col-md-6">
        {% if not isMaintenanceMode %}
        <h2 class="pmf-footer-title">{{ languageBox }}</h2>
        <label class="visually-hidden" for="language">{{ languageBox }}</label>
        <form accept-charset="utf-8" action="./" method="post" id="pmf-footer-language-switcher">
          <div class="form-group d-flex">
            {{ switchLanguages | raw }}
            <input name="action" type="hidden" value="">
          </div>
        </form>
        {% endif %}
      </div>
      <div class="col-xl-6 col-lg-7 col-md-5 offset-xl-2 offset-md-1 pt-4 pt-md-1 pt-lg-0">
        <div id="footer-links" class="row">
          <div class="col-lg-4">
            <h2 class="pmf-footer-title">{{ 'msgFooterLinks' | translate }}</h2>
            <ul class="nav flex-column pb-lg-1 mb-lg-3">
              {% if not isMaintenanceMode %}
                {% for item in footerNavigation %}
                  <li class="nav-item">
                    <a href="{{ item['link'] }}" class="nav-link d-inline-block px-0 pt-1 pb-2 {{ item['active'] }}">
                      {{ item['name'] }}
                    </a>
                  </li>
                {% endfor %}
                {% if isImprintLinkEnabled %}
                  <li class="nav-item">
                    <a class="nav-link d-inline-block px-0 pt-1 pb-2" target="_blank" href="./imprint.html">
                      {{ msgImprint }}
                    </a>
                  </li>
                {% endif %}
              {% endif %}
            </ul>
          </div>
          <div class="col-lg-4">
            <h2 class="pmf-footer-title">{{ 'msgFooterLegal' | translate }}</h2>
            <ul class="nav flex-column pb-lg-1 mb-lg-3">
              {% if not isMaintenanceMode %}
                {% if isPrivacyLinkEnabled %}
                  <li class="nav-item">
                    <a class="nav-link d-inline-block px-0 pt-1 pb-2" target="_blank" href="./privacy.html">
                      {{ msgPrivacyNote }}
                    </a>
                  </li>
                {% endif %}
                {% if isTermsLinkEnabled %}
                  <li class="nav-item">
                    <a class="nav-link d-inline-block px-0 pt-1 pb-2" target="_blank" href="./terms.html">
                      {{ msgTermsOfService }}
                    </a>
                  </li>
                {% endif %}
                {% if isCookieConsentEnabled %}
                  <li class="nav-item">
                    <a id="showCookieConsent" class="nav-link d-inline-block px-0 pt-1 pb-2" href="#">
                      {{ cookiePreferences }}
                    </a>
                  </li>
                {% endif %}
                {% if isAccessibilityStatementEnabled %}
                  <li class="nav-item">
                    <a class="nav-link d-inline-block px-0 pt-1 pb-2" target="_blank" href="./accessibility.html">
                      {{ msgAccessibilityStatement }}
                    </a>
                  </li>
                {% endif %}
              {% endif %}
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="pmf-footer-bottom text-center text-md-start">
      <span>© {{ currentYear }} All rights reserved. Powered with ❤️ and ☕️ by
        <a href="https://www.phpmyfaq.de/" target="_blank" rel="noopener">phpMyFAQ</a> {{ version }}</span>
    </div>
  </div>
</footer>

<!-- Floating help button -->
{% if not isMaintenanceMode and not (currentPageUrl matches '/\\/contact\\.html([?#]|$)/') %}
<a class="pmf-help-button" href="./contact.html">
  <i class="bi bi-chat-dots" aria-hidden="true"></i>
  <span class="pmf-help-button-label">{{ 'msgContact' | translate }}</span>
</a>
{% endif %}

<!-- Push notification opt-in banner -->
{% if pushEnabled and isUserLoggedIn %}
<div id="pmf-push-banner" class="position-fixed bottom-0 start-0 end-0 d-none" style="z-index: 1050;" data-pmf-csrf="{{ csrfTokenPushSubscription }}">
  <div class="container">
    <div class="alert alert-info alert-dismissible shadow-lg mb-0 rounded-0 rounded-top d-flex align-items-center" role="alert">
      <i class="bi bi-bell fs-4 me-3 flex-shrink-0" aria-hidden="true"></i>
      <div class="flex-grow-1">
        <strong>{{ 'msgPushNotifications' | translate }}</strong>
        <span class="ms-1 d-none d-md-inline">{{ 'msgPushNotificationsDescription' | translate }}</span>
      </div>
      <button type="button" class="btn btn-primary btn-sm ms-3 flex-shrink-0" id="pmf-push-banner-enable">
        {{ 'msgPushNotificationsEnable' | translate }}
      </button>
      <button type="button" class="btn-close ms-2 flex-shrink-0" id="pmf-push-banner-dismiss" aria-label="Close"></button>
    </div>
  </div>
</div>
{% endif %}

<!-- Frontend toasts -->
<div class="toast-container position-fixed top-0 start-50 translate-middle-x mt-5 p-3">
  <div id="pmf-notification" class="toast align-items-center text-bg-success shadow border-0" role="alert"
       aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="pmf-notification-message">
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close">
      </button>
    </div>
  </div>

  <div id="pmf-notification-error" class="toast align-items-center text-bg-danger shadow border-0" role="alert"
       aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="pmf-notification-error-message">
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close">
      </button>
    </div>
  </div>
</div>

{% if isCookieConsentEnabled %}
<script type="module" src="./{{ asset('assets/public/cookieConsent.js') }}"></script>
{% endif %}
{% if pluginScripts is defined and pluginScripts is not empty %}
  {% for script in pluginScripts %}
<script src="{{ baseHref }}{{ script }}"></script>
  {% endfor %}
{% endif %}
<script type="module" src="./{{ asset('assets/public/frontend.js') }}"></script>
{% if successMessage or errorMessage %}
<script type="module" nonce="{{ cspNonce() }}">
  import { pushNotification, pushErrorNotification } from './{{ asset('assets/public/notifications.js') }}';
  {% if successMessage %}
  pushNotification('{{ successMessage|e('js') }}');
  {% endif %}
  {% if errorMessage %}
  pushErrorNotification('{{ errorMessage|e('js') }}');
  {% endif %}
</script>
{% endif %}
</body>
</html>
