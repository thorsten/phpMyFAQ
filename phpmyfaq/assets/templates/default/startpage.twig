{% extends 'index.twig' %}
{% set isStartPage = true %}

{% block content %}

<!-- Hero -->
<section class="pmf-hero">
  <div class="pmf-hero-inner">
    <h1 class="pmf-display-1 mb-3 pmf-start-page">{{ pageHeader | raw }}</h1>
    {% if metaDescription is defined and metaDescription is not empty %}
      <p class="pmf-hero-subline">{{ metaDescription }}</p>
    {% endif %}
    {% if not isMaintenanceMode %}
      {% include 'partials/search-form.twig' %}
    {% endif %}
    <span class="pmf-hero-pill">{{ writeNumberOfArticles }}</span>
  </div>
</section>

<!-- Start page category tiles -->
{% if startPageCategories %}
  <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3 mb-5">
    {% for decks in startPageCategoryDecks %}
      <div class="col">
        <a class="pmf-category-tile" href="{{ decks['url'] }}">
          {% if decks['image'] != '' %}
            <img class="pmf-category-tile-avatar" src="{{ decks['image'] }}" alt="" width="48" height="48">
          {% else %}
            <span class="pmf-category-tile-avatar" aria-hidden="true">{{ decks['name'] | first | upper }}</span>
          {% endif %}
          <span class="pmf-category-tile-body">
            <span class="pmf-category-tile-name h5">{{ decks['name'] }}</span>
            {% if decks['description'] is not empty %}
              <span class="pmf-category-tile-desc">{{ decks['description'] }}</span>
            {% endif %}
          </span>
          <i class="bi bi-arrow-right pmf-category-tile-chevron" aria-hidden="true"></i>
        </a>
      </div>
    {% endfor %}
  </div>
{% endif %}

<!-- Start page content -->
{% set hasAside = newsList is not empty or tagsList is not empty %}
<div class="row g-4">
  <div class="{{ hasAside ? 'col-lg-8' : 'col-lg-12' }}">

    {% if stickyRecordsList is not empty %}
      <div class="pmf-callout mb-4">
        <h2 class="h6 pmf-callout-title"><i class="bi bi-pin-angle-fill" aria-hidden="true"></i> {{ stickyRecordsHeader }}</h2>
        <ul class="pmf-callout-list">
          {% for stickyRecord in stickyRecordsList %}
            <li><a class="sticky-faqs" href="{{ stickyRecord['url'] }}">{{ stickyRecord['question'] }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <section class="pmf-faq-list-section pmf-surface mb-4">
      <header class="pmf-faq-list-header">
        <h2 class="h5 mb-0"><i class="bi bi-trophy" aria-hidden="true"></i> {{ writeTopTenHeader }}</h2>
        <span class="small">{{ writeNumberOfArticles }}</span>
      </header>
      {% if topRecordsList is not empty %}
        <ol class="pmf-faq-list">
          {% for topten in topRecordsList %}
            <li class="pmf-faq-list-item">
              <a class="latest-entries pmf-faq-list-link" href="{{ topten.url }}">{{ topten.title | raw }}</a>
              <span class="pmf-faq-list-meta"><i class="bi bi-eye" aria-hidden="true"></i> {{ topten.visits }}</span>
            </li>
          {% endfor %}
        </ol>
      {% else %}
        <p class="pmf-faq-list-empty small mb-0">{{ errorMsgTopTen }}</p>
      {% endif %}
    </section>

    {% if latestRecordsList is not empty %}
      <section class="pmf-faq-list-section pmf-surface mb-4">
        <header class="pmf-faq-list-header">
          <h2 class="h5 mb-0"><i class="bi bi-lightning" aria-hidden="true"></i> {{ writeNewestHeader }}</h2>
        </header>
        <ol class="pmf-faq-list">
          {% for latest in latestRecordsList %}
            <li class="pmf-faq-list-item">
              <a class="latest-entries pmf-faq-list-link" href="{{ latest.url }}" title="{{ latest.preview }}">{{ latest.title | raw }}</a>
              <span class="pmf-faq-list-meta"><i class="bi bi-calendar-date" aria-hidden="true"></i> {{ latest.date }}</span>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}

    {% if trendingRecordsList is not empty %}
      <section class="pmf-faq-list-section pmf-surface mb-4">
        <header class="pmf-faq-list-header">
          <h2 class="h5 mb-0"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> {{ msgTrendingFAQs }}</h2>
        </header>
        <ol class="pmf-faq-list">
          {% for trending in trendingRecordsList %}
            <li class="pmf-faq-list-item">
              <a class="latest-entries pmf-faq-list-link" href="{{ trending.url }}" title="{{ trending.preview }}">{{ trending.title | raw }}</a>
              <span class="pmf-faq-list-meta">
                <i class="bi bi-eye" aria-hidden="true"></i> {{ trending.visits }}
                <span class="pmf-faq-list-dot" aria-hidden="true"></span>
                <i class="bi bi-calendar-date" aria-hidden="true"></i> {{ trending.date }}
              </span>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}
  </div>

  {% if hasAside %}
  <aside class="col-lg-4">
    {% if newsList is not empty %}
      <section class="pmf-surface pmf-news mb-4">
        <h2 class="h5 pmf-news-title"><i class="bi bi-newspaper" aria-hidden="true"></i> {{ msgNewsHeader }}</h2>
        <ol class="pmf-news-list">
          {% for news in newsList %}
            <li class="pmf-news-item">
              <time class="pmf-news-date">{{ news.date }}</time>
              <a class="news-entries pmf-news-link" href="{{ news.url }}">{{ news.header }}</a>
              <p class="pmf-news-excerpt">{{ news.content }}</p>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}

    {% if tagsList is not empty %}
      <section class="pmf-surface pmf-tags mb-4">
        <h2 class="h5 pmf-news-title"><i class="bi bi-tags" aria-hidden="true"></i> {{ msgTags }}</h2>
        <div class="pmf-tag-cloud">
          {% for tagId, tagFrequency in tagsList %}
            <a class="btn btn-outline-primary btn-sm m-1" href="./search.html?tagging_id={{ tagId }}">
              {{ tagId | tagName }} <span class="badge pmf-badge-count">{{ tagFrequency }}</span>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </aside>
  {% endif %}
</div>

{% endblock %}
