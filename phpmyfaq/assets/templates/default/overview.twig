{% extends 'index.twig' %}

{% block content %}
<section class="col-12 pmf-overview">
  <header class="pmf-page-header">
    <h1 class="h2 pmf-display-2 mb-0">{{ pageHeader }}</h1>
  </header>

  {% set lastCategory = 0 %}
  {% for faq in faqOverview %}

    {% if (faq['category_id'] != null and faq['category_id'] != lastCategory) %}
      {% if lastCategory != 0 %}
        </div>
      {% endif %}
      <div class="pmf-overview-section">
      <header class="pmf-overview-section-header">
        <h2 class="h4 mb-0">
          <span class="pmf-overview-section-avatar" aria-hidden="true">{{ (faq['category_id'] | categoryName) | first | upper }}</span>
          {{ faq['category_id'] | categoryName }}
        </h2>
        <a href="{{ categoryLink(faq['category_id']) }}" class="btn btn-outline-primary btn-sm">
          {{ 'msgGoToCategory' | translate }}
          <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
        </a>
      </header>
    {% endif %}

    {% if (faq['category_id'] != null) %}
    <article class="pmf-surface pmf-overview-item">
      <h3 class="h5 pmf-overview-item-title">
        <a href="{{ faqLink(faq['category_id'], faq['id'], faq['lang']) }}">{{ faq['title'] }}</a>
      </h3>
      <div class="pmf-overview-item-body">
        {{ faq['content'] | raw }}
      </div>
      <footer class="pmf-overview-item-meta">
        <span><i class="bi bi-calendar-date" aria-hidden="true"></i> {{ faq['updated'] | date('Y-m-d H:i') }}</span>
        <span><i class="bi bi-person" aria-hidden="true"></i> {{ faq['author'] }}</span>
        <a class="ms-auto" href="{{ faqLink(faq['category_id'], faq['id'], faq['lang']) }}"
           aria-label="{{ faq['id'] | faqQuestion }}">
          <i class="bi bi-link-45deg" aria-hidden="true"></i> {{ 'msgPermalink' | translate }}
        </a>
      </footer>
    </article>
    {% endif %}

    {% set lastCategory = faq['category_id'] %}
  {% endfor %}
  {% if lastCategory != 0 %}
    </div>
  {% endif %}
</section>

{% endblock %}
