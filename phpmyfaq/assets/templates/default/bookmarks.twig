{% extends 'index.twig' %}

{% block content %}
<section class="col-12 pmf-bookmarks">
  <header class="pmf-page-header pmf-page-header-actions">
    <h1 class="h2 pmf-display-2 mb-0">{{ 'msgMyBookmarks' | translate }}</h1>
    <button type="button" class="btn btn-outline-danger btn-sm" id="pmf-bookmarks-delete-all"
            data-pmf-csrf="{{ csrfTokenDeleteAllBookmarks }}"{% if bookmarksList is empty %} disabled{% endif %}>
      <i aria-hidden="true" class="bi bi-trash"></i>
      {{ 'msgRemoveAll' | translate }}
    </button>
  </header>

  <div class="accordion pmf-bookmark-list" id="bookmarkAccordion">
    {% if bookmarksList is empty %}
      <div class="pmf-surface pmf-empty-state">
        <i class="bi bi-bookmark-star" aria-hidden="true"></i>
        <p class="mb-0">{{ 'msgNoBookmarks' | translate }}</p>
      </div>
    {% endif %}
    {% set count = 1 %}
    {% for bookmark in bookmarksList %}
      <div class="accordion-item pmf-surface pmf-bookmark-item" id="delete-bookmark-{{ bookmark['id'] }}">
        <h2 class="accordion-header" id="heading{{ count }}">
          <button class="accordion-button d-flex collapsed justify-content-between" type="button"
                  data-bs-toggle="collapse" data-bs-target="#collapse{{ count }}" aria-expanded="false"
                  aria-controls="collapse{{ count }}">
            <i class="bi bi-bookmark-fill pmf-bookmark-icon" aria-hidden="true"></i>
            <span class="flex-grow-1 text-start">{{ bookmark['title'] }}</span>
            <i class="bi bi-trash text-danger m-1 pmf-delete-bookmark" title="{{ 'removeBookmark' | translate }}"
               role="button" tabindex="0" aria-label="{{ 'removeBookmark' | translate }}"
               data-bs-toggle="tooltip" data-bs-placement="top" data-pmf-bookmark-id="{{ bookmark['id'] }}"
               data-pmf-csrf="{{ csrfTokenDeleteBookmark }}">
            </i>&nbsp;
          </button>
        </h2>
        <div id="collapse{{ count }}" class="accordion-collapse collapse" aria-labelledby="heading{{ count }}"
             data-bs-parent="#bookmarkAccordion">
          <div class="accordion-body pmf-bookmark-body">
            {{ bookmark['answer'] | raw }}
            <a class="btn btn-outline-primary btn-sm mt-2" href="{{ bookmark['url'] }}">
              {{ 'msgLinkToFAQ' | translate }} <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
      {% set count = count + 1 %}
    {% endfor %}
  </div>
</section>

{% endblock %}
