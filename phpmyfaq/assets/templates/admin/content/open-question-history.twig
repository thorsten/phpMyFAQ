{% extends '@admin/index.twig' %}

{% block content %}
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 mb-3 border-bottom">
    <h1 class="h2">
      <i aria-hidden="true" class="bi bi-clock-history"></i>
      {{ msgQuestionHistory }}
    </h1>
    <a href="./questions" class="btn btn-outline-secondary">
      {{ msgOpenQuestions }}
    </a>
  </div>

  <div class="row">
    <div class="col-lg-12">
      {% if question %}
        <p class="lead">{{ question.question | raw }}</p>
      {% endif %}

      {% if entries | length > 0 %}
        <table class="table table-striped align-middle border shadow">
          <thead>
          <tr>
            <th>{{ msgQuestionHistoryDate }}</th>
            <th>{{ msgQuestionHistoryEvent }}</th>
            <th>{{ msgAuthor }}</th>
          </tr>
          </thead>
          <tbody>
          {% for entry in entries %}
            <tr>
              <td>{{ entry.created }}</td>
              <td>
                {{ eventLabels[entry.eventType] ?? entry.eventType }}
                {% if entry.faqId > 0 %}
                  (FAQ #{{ entry.faqId }})
                {% endif %}
              </td>
              <td>{{ entry.username }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="alert alert-info" role="alert">
          {{ msgNoQuestionHistory }}
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
