# phpMyFAQ production environment for docker-compose.prod.yml
#
# Copy this file to .env next to docker-compose.prod.yml. Docker Compose reads
# it automatically; Portainer users paste the variables into the stack's
# environment instead. See docs/deployment.md.

# --- Which services to run ---------------------------------------------------
# web server: apache | frankenphp     database: mariadb | postgres
# search engine (optional): elasticsearch | opensearch
COMPOSE_PROFILES=apache,mariadb

# --- Image -------------------------------------------------------------------
# Pin a release, e.g. 4.2.0. "latest" always follows the newest stable release.
# Images are published to the GitHub Container Registry.
PMF_IMAGE=ghcr.io/thorsten/phpmyfaq
PMF_VERSION=latest

# --- Ports -------------------------------------------------------------------
PMF_HTTP_PORT=80
# frankenphp only
PMF_HTTPS_PORT=443
# frankenphp only: ":80" = plain HTTP behind a reverse proxy, a public host name
# such as faq.example.com enables automatic HTTPS with Let's Encrypt
SERVER_NAME=:80

# --- PHP ---------------------------------------------------------------------
PMF_TIMEZONE=UTC
PMF_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M

# --- Database (MariaDB profile) ------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=phpmyfaq
MYSQL_USER=phpmyfaq
MYSQL_PASSWORD=change-me

# --- Database (PostgreSQL profile) ---------------------------------------------
POSTGRES_DB=phpmyfaq
POSTGRES_USER=phpmyfaq
POSTGRES_PASSWORD=change-me

# --- Headless installation (optional) ------------------------------------------
# When PMF_DB_HOST and PMF_ADMIN_PASSWORD are set, the container installs
# phpMyFAQ on its first start with these values. Leave PMF_DB_HOST empty to use
# the web installer at http://<host>/setup/ instead. The values are only read
# while no installation exists; change them later in the administration.
#
# PMF_DB_TYPE:  mysqli for MariaDB (PMF_DB_HOST=mariadb), pgsql for PostgreSQL
#               (PMF_DB_HOST=postgres)
PMF_DB_TYPE=mysqli
PMF_DB_HOST=mariadb
PMF_DB_NAME=phpmyfaq
PMF_DB_USER=phpmyfaq
PMF_DB_PASS=change-me
PMF_ADMIN_USER=admin
PMF_ADMIN_PASSWORD=change-me-at-least-8-characters
# Public URL of the FAQ, used for absolute links (no trailing slash)
PMF_BASE_URL=http://localhost

# --- Search engine (optional) --------------------------------------------------
# Set exactly one, matching the chosen profile, and enable the search engine in
# the administration afterwards.
ELASTICSEARCH_BASE_URI=
OPENSEARCH_BASE_URI=
# ELASTICSEARCH_BASE_URI=http://elasticsearch:9200
# OPENSEARCH_BASE_URI=http://opensearch:9200
