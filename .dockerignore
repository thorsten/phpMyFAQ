# Build context rules for both the test image (./Dockerfile) and the
# production image (.docker/production/Dockerfile). Dependencies and frontend
# assets are built inside the images; local runtime state never ends up in one.
.git
.github
.claude
.husky
.idea
.vscode
.pnpm-store
node_modules
build
coverage
html-coverage
site
volumes
docs
*.pem
docker-compose*.yml
.env
.env.*
phpmyfaq/.env
phpmyfaq/src/libs
phpmyfaq/assets/public
phpmyfaq/content/core/cache
phpmyfaq/content/core/data/*
!phpmyfaq/content/core/data/.gitkeep
phpmyfaq/content/core/logs/*
!phpmyfaq/content/core/logs/.gitkeep
phpmyfaq/content/upgrades/*
!phpmyfaq/content/upgrades/.gitkeep
phpmyfaq/content/core/config/database.php
phpmyfaq/content/core/config/*.bak.php
phpmyfaq/content/core/config/ldap.php
phpmyfaq/content/core/config/elasticsearch.php
phpmyfaq/content/core/config/opensearch.php
phpmyfaq/content/core/config/azure.php
phpmyfaq/content/core/config/update-token.php
phpmyfaq/content/core/config/*.zip
